# ====================================================================
# .env.example — Copy this to .env and fill in your Snowflake credentials
# NEVER commit the actual .env file to GitHub
# ====================================================================

# Snowflake connection details (used when creating the connection in Airflow UI)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=snowmart_db
SNOWFLAKE_SCHEMA=bronze
SNOWFLAKE_WAREHOUSE=snowmart_etl_wh
SNOWFLAKE_ROLE=snowmart_data_engineer
